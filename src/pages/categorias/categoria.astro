---
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { sitio } from '../../../sitio.js';
import { getPosts, categoriaInfo } from '../../lib/utils.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  const claves = [...new Set([...Object.keys(sitio.categorias), ...posts.map((p) => p.data.categoria)])];
  return claves.map((clave) => ({
    params: { categoria: clave },
    props: { posts: posts.filter((p) => p.data.categoria === clave) },
  }));
}

const { categoria } = Astro.params;
// 1. Asignamos un arreglo vacío por defecto a posts
const { posts = [] } = Astro.props; 

// 2. Protegemos cat por si categoriaInfo(categoria) no encuentra la categoría
const cat = categoriaInfo(categoria) || { 
  nombre: categoria, 
  descripcion: sitio.descripcion, 
  emoji: '📁', 
  color: 'default' 
};
---

<Base titulo={`${sitio.textos.articulosEn} ${cat.nombre}`} descripcion={cat.descripcion || sitio.descripcion}>
  <div class="contenedor">
    <Cabecera etiqueta={sitio.textos.articulosEn} titulo={cat.nombre} emoji={cat.emoji} descripcion={cat.descripcion} color={cat.color} />
    <div class="layout">
      <section>
        <div class="posts-grid posts-grid-lista">
          {posts?.map((p) => <PostCard post={p} />)}
        </div>
      </section>
      <Sidebar />
    </div>
  </div>
</Base>
