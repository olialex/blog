---
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import SerieCard from '../../components/SerieCard.astro';
import SlideComic from '../../components/SlideComic.astro';
import Icono from '../../components/Icono.astro';
import '../../styles/slides.css';
import { sitio } from '../../../sitio.js';
import { getPosts, seriesDe, ruta } from '../../lib/utils.js';

const series = seriesDe(await getPosts());
const w = sitio.webcomics;
const t = sitio.textos;
const colores = ['rosa', 'azul', 'verde', 'naranja', 'morado', 'amarillo']; // orden de colores de las pantallas (móvil)
---

<Base titulo={w.titulo} descripcion={w.descripcion}>
  <!-- ===== MÓVIL: una pantalla por serie ===== -->
  <div class="wc-movil">
    <section class="wc-slide wc-intro">
      <Cabecera etiqueta={w.etiqueta} titulo={w.titulo} descripcion={w.descripcion} color="morado" emoji={w.emoji} />
      {series.length > 0 ? <span class="wc-desliza" aria-hidden="true">{t.desliza ?? 'desliza'} <Icono nombre="flecha-abajo" tamano={16} /></span> : <p class="vacio">{w.vacio}</p>}
    </section>
    {
      series.map((s, i) => {
        const n = s.capitulos.length;
        return (
          <SlideComic
            indice={i + 1}
            total={series.length}
            color={colores[i % colores.length]}
            titulo={s.nombre}
            descripcion={s.capitulos[0].data.descripcion}
            imagen={s.portada}
            href={ruta(`/webcomics/${s.slug}/`)}
            boton={t.verSerie ?? 'VER SERIE'}
            etiqueta={`${n} ${n === 1 ? t.capitulo.toLowerCase() : t.capitulos}`}
            ultimo={i === series.length - 1}
          />
        );
      })
    }
  </div>

  <!-- ===== ESCRITORIO / TABLET: cuadrícula de siempre ===== -->
  <div class="contenedor wc-escritorio">
    <Cabecera etiqueta={w.etiqueta} titulo={w.titulo} descripcion={w.descripcion} color="morado" emoji={w.emoji} />
    {
      series.length > 0 ? (
        <div class="posts-grid">
          {series.map((s) => <SerieCard serie={s} />)}
        </div>
      ) : (
        <p class="vacio">{w.vacio}</p>
      )
    }
  </div>
</Base>
