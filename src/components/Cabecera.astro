---
// Cabecera de página reutilizable: etiqueta manuscrita + título + descripción
import Icono from './Icono.astro';
const { etiqueta, titulo, descripcion, color = 'amarillo', emoji, icono } = Astro.props;
---

<header class="cabecera">
  {etiqueta && <div class="handwritten-label">{etiqueta}</div>}
  <h1 class="cabecera-titulo" style={`--acento:var(--c-${color})`}>
    {icono && <Icono nombre={icono} tamano={34} clase="cabecera-icono" />}{emoji && <span>{emoji} </span>}<span class="resaltado">{titulo}</span>
  </h1>
  {descripcion && <p class="cabecera-desc">{descripcion}</p>}
</header>
